{
  "trailingComma": "none",
  "printWidth": 120,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": true,
  "plugins": [
    "prettier-plugin-apex"
  ],
  "overrides": [
    {
      "files": "**/lwc/**/*.html",
      "options": {
        "parser": "lwc"
      }
    },
    {
      "files": "*.{trigger,cls}",
      "options": {
        "parser": "apex"
      }
    }
  ]
}