<apex:page controller="DemoTest">
    <apex:form >
        <apex:pageBlock title="Account Search by Website">
            <apex:pageBlockSection columns="2">
                <apex:inputText value="{!userInput}" label="Enter Account Website"/>
                <apex:commandButton value="Search" action="{!processInput}" rerender="result"/>
            </apex:pageBlockSection>
        </apex:pageBlock>
        
        <apex:outputPanel id="result">
            <apex:pageBlock title="Results">
                <apex:repeat value="{!wrapperList}" var="wrap">
                    <apex:pageBlockSection title="Account ID: {!wrap.key}" columns="1">
                        <apex:pageBlockTable value="{!wrap.value1['contacts']}" var="c">
                            <apex:column value="{!c.Name}" headerValue="Contact Name"/>
                            <apex:column value="{!c.Email}" headerValue="Email"/>
                        </apex:pageBlockTable>
                        
                        <apex:pageBlockTable value="{!wrap.value1['opportunities']}" var="o">
                            <apex:column value="{!o.Name}" headerValue="Opportunity Name"/>
                            <apex:column value="{!o.StageName}" headerValue="Stage"/>
                        </apex:pageBlockTable>
                    </apex:pageBlockSection>
                </apex:repeat>
            </apex:pageBlock>
        </apex:outputPanel>
    </apex:form>
</apex:page>